{
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    { "source": "/download", "destination": "/kiosk-ui/download" },
    { "source": "/download/", "destination": "/kiosk-ui/download" },
    { "source": "/ar", "destination": "/kiosk-ui/ar" },
    { "source": "/ar/", "destination": "/kiosk-ui/ar" },
    { "source": "/ar-upload", "destination": "/kiosk-ui/ar-upload" },
    { "source": "/ar-upload/", "destination": "/kiosk-ui/ar-upload" },
    { "source": "/admin", "destination": "/kiosk-ui/admin" },
    { "source": "/admin/", "destination": "/kiosk-ui/admin" },
    { "source": "/", "destination": "/kiosk-ui/" },
    { "source": "/kiosk-ui", "destination": "/kiosk-ui/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}